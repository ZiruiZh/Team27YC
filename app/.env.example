# Copy to .env.local (git-ignored) and fill in.

# ElevenLabs API key for spoken demo lines (text-to-speech). Server-side only:
# the Vite dev server proxies /api/tts and adds this key, so it never reaches the browser bundle.
# Without it, the demo falls back to the browser's built-in voice.
ELEVENLABS_API_KEY=

# The ElevenLabs conversational agent used for live voice (defaults to the team agent).
VITE_ELEVENLABS_AGENT_ID=agent_7701m826461tf5y9qty5ghbjhhqn
